{
  "expo": {
    "name": "PrevenTech",
    "slug": "pm-app-inl",
    "scheme": "pmapp",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ebe6dc"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.co.inl.pmapp",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "PrevenTech memerlukan akses kamera untuk memotret kondisi alat/pekerjaan pada Work Order dan Form Request.",
        "NSPhotoLibraryUsageDescription": "PrevenTech memerlukan akses galeri untuk melampirkan foto pada Work Order dan Form Request.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "id.co.inl.pmapp",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ebe6dc"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#126e66",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PrevenTech memerlukan akses galeri untuk melampirkan foto pada Work Order dan Form Request.",
          "cameraPermission": "PrevenTech memerlukan akses kamera untuk memotret kondisi alat/pekerjaan pada Work Order dan Form Request.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
