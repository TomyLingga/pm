{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PM_API_URL": "http://192.168.16.136:8000/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PM_API_URL": "https://pm.inl.co.id/api/v1"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PM_API_URL": "https://pm.inl.co.id/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "<apple-id@inl.co.id>",
        "ascAppId": "<App Store Connect app id>",
        "appleTeamId": "<Team ID>"
      }
    }
  }
}
