# Laravel backend (pm-api) target for the /api/* and /sanctum/* proxy.
# Read at `next build` time and when `next dev` starts (rewrites are baked into the build).
# Docker network example: http://pm-be:8000
BACKEND_URL=http://127.0.0.1:8000

# UUID of the PM-App row in the Portal INTES `aplikasi` table (sent as app_id when the URL has no appId).
NEXT_PUBLIC_PORTAL_APP_ID=00000000-0000-0000-0000-000000000000

# Portal launch URL for this app. Used when there is no session (middleware) or the API returns 401.
NEXT_PUBLIC_PORTAL_LAUNCH_URL=https://portal.inl.co.id/launch?app_id=00000000-0000-0000-0000-000000000000

# Portal home page; the browser goes here after logout.
NEXT_PUBLIC_PORTAL_HOME_URL=https://portal.inl.co.id
