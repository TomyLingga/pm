# ─── PrevenTech web (pm-web, Next.js) — contoh .env ───
# Salin ke .env (atau .env.local) lalu sesuaikan. Di produksi (docker-compose.prod.yml) nilai NEXT_PUBLIC_*
# diturunkan otomatis dari PORTAL_APP_ID dan PORTAL_WEB_URL di .env.prod, dan BACKEND_URL mengarah ke container pm-api.

# Target Laravel (pm-api) untuk proxy /api/* dan /sanctum/*.
# Dibaca saat `next build` dan saat `next dev` mulai (rewrite dibakar ke dalam build), jadi restart setelah mengubah.
# Dev lokal: http://127.0.0.1:8000 · Docker: http://pm-api:8000
BACKEND_URL=http://127.0.0.1:8000

# UUID PrevenTech di tabel `aplikasi` Portal INTES (dikirim sebagai app_id bila URL dari Portal tidak membawa appId).
NEXT_PUBLIC_PORTAL_APP_ID=00000000-0000-0000-0000-000000000000

# URL peluncuran aplikasi di Portal. Dipakai saat belum ada sesi (middleware) atau API menjawab 401.
NEXT_PUBLIC_PORTAL_LAUNCH_URL=https://portal.inl.co.id/launch?app_id=00000000-0000-0000-0000-000000000000

# Beranda Portal; browser diarahkan ke sini setelah logout.
NEXT_PUBLIC_PORTAL_HOME_URL=https://portal.inl.co.id

# Opsional: port dev server dan folder output build (dipakai bila ingin build terpisah dari `.next` dev).
# PORT=3000
# NEXT_DIST_DIR=.next
