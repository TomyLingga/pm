# ─── PM-App produksi — dibaca oleh docker-compose.prod.yml DAN oleh Laravel di dalam container ───
# Salin ke .env.prod, isi semua nilai bertanda <...>, jangan commit file .env.prod.

# Host & domain
PM_DOMAIN=pm.inl.co.id
PM_CERT_DIR=/etc/pm-app/certs          # berisi fullchain.pem + privkey.pem
PM_BACKUP_DIR=/var/backups/pm-app
PM_VERSION=latest
BACKUP_CRON=15 1 * * *
BACKUP_KEEP_DAYS=14

# Laravel
APP_NAME="PrevenTech"
APP_ENV=production
APP_KEY=                               # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://pm.inl.co.id
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database (PostgreSQL 17 di container pm-db; DB_HOST diisi compose)
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=pm
DB_USERNAME=pm
DB_PASSWORD=<kata-sandi-kuat>

# Cache / sesi / queue lewat Redis (REDIS_HOST diisi compose)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Sesi web (Sanctum SPA cookie, satu origin: nginx)
SESSION_LIFETIME=120
SESSION_COOKIE=pm_app_session
SESSION_DOMAIN=pm.inl.co.id
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pm.inl.co.id
FILESYSTEM_DRIVER=local

# Portal INTES (docs/SSO.md)
PORTAL_API_URL=https://portal.inl.co.id
PORTAL_WEB_URL=https://portal.inl.co.id
PORTAL_APP_ID=<uuid aplikasi "PM-App" produksi di tabel aplikasi Portal>
PORTAL_INTERNAL_TOKEN=<SSO_INTERNAL_TOKEN dari .env Portal>
PORTAL_HTTP_TIMEOUT=10
PORTAL_VERIFY_TLS=true

# Aturan PM-App
PM_WEB_URL=https://pm.inl.co.id
PM_LEAD_GRADE_CODES=BOM,BOM-1,BOM-2,BOM-3
PM_WORKING_DAYS=1,2,3,4,5
PM_WO_AUTO_ACCEPT_DAYS=3
PM_ATTACHMENT_DISK=local
PM_DUE_WINDOW_HOURS=48
PM_OVERDUE_REMINDER_HOURS=48
PM_HORIZON_DAYS=60
PM_HORIZON_DAYS_HOURLY=7
PM_DASHBOARD_CACHE_SECONDS=300
PM_LIVE_UPCOMING_HOURS=48

# Notifikasi
PM_MAIL_NOTIFICATIONS=false            # true bila SMTP di bawah sudah diisi
MAIL_MAILER=smtp
MAIL_HOST=<smtp.inl.co.id>
MAIL_PORT=587
MAIL_USERNAME=<user smtp>
MAIL_PASSWORD=<password smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=pm-app@inl.co.id
MAIL_FROM_NAME="PM-App"
EXPO_ACCESS_TOKEN=<token Expo untuk push Android, boleh kosong>
