# ─── PrevenTech produksi — dibaca oleh docker-compose.prod.yml DAN oleh Laravel di dalam container ───
# Salin ke .env.prod (chmod 600), isi semua nilai bertanda <...>, jangan commit file .env.prod.
# DB_HOST dan REDIS_HOST tidak perlu diisi: compose mengarahkannya ke container pm-db / pm-redis.
# Variabel pm-web (NEXT_PUBLIC_*) diturunkan compose dari PORTAL_APP_ID dan PORTAL_WEB_URL saat build image.

# ── Host & domain (dipakai compose) ──
PM_DOMAIN=pm.inl.co.id                   # domain publik; nginx + sertifikat
PM_CERT_DIR=/etc/pm-app/certs            # berisi fullchain.pem + privkey.pem
PM_BACKUP_DIR=/var/backups/pm-app        # tujuan dump PostgreSQL harian
PM_VERSION=latest                        # tag image yang dibangun deploy.sh
BACKUP_CRON="15 1 * * *"                 # jadwal backup (cron, zona waktu container); nilai berspasi harus dikutip
BACKUP_KEEP_DAYS=14                      # simpan backup n hari

# ── Laravel ──
APP_NAME="PrevenTech"
APP_ENV=production
APP_KEY=                                 # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://pm.inl.co.id
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (PostgreSQL 17 di container pm-db) ──
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=pm
DB_USERNAME=pm
DB_PASSWORD=<kata-sandi-kuat>

# ── Cache / sesi / queue lewat Redis (container pm-redis; pm-worker menjalankan queue:work) ──
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
FILESYSTEM_DRIVER=local

# ── Sesi web (Sanctum SPA cookie; web dan API satu origin lewat nginx) ──
SESSION_LIFETIME=120
SESSION_COOKIE=pm_app_session
SESSION_DOMAIN=pm.inl.co.id
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pm.inl.co.id

# ── Portal INTES (docs/SSO.md) ──
PORTAL_API_URL=https://portal.inl.co.id
PORTAL_WEB_URL=https://portal.inl.co.id
PORTAL_APP_ID="<uuid aplikasi PrevenTech produksi di tabel aplikasi Portal>"
PORTAL_INTERNAL_TOKEN="<SSO_INTERNAL_TOKEN dari .env Portal>"
PORTAL_HTTP_TIMEOUT=10
PORTAL_VERIFY_TLS=true

# ── Aturan PrevenTech ──
PM_WEB_URL=https://pm.inl.co.id          # tautan di notifikasi/email
PM_LEAD_GRADE_CODES=BOM,BOM-1,BOM-2,BOM-3
PM_WORKING_DAYS=1,2,3,4,5
PM_WO_AUTO_ACCEPT_DAYS=3
PM_APPROVAL_REMINDER_HOURS=24
PM_ATTACHMENT_DISK=local                 # lampiran di volume storage container pm-api

# ── Nomor dokumen di PDF/cetakan ──
PM_WO_DOC_NUMBER=FM-BOPS-10/05
PM_WO_DOC_EFFECTIVE_DATE=09-Sept-25
PM_WO_DOC_REVISION=01
PM_REQ_DOC_NUMBER=INLHO/BSIS-ITC/F-004
PM_REQ_DOC_EFFECTIVE_DATE=04-Mei-22
PM_REQ_DOC_REVISION=01
PM_REQ_DOC_VERSION_NOTE="versi dokumen : 1/Agustus 2019"

# ── Preventive Maintenance ──
PM_DUE_WINDOW_HOURS=48
PM_OVERDUE_REMINDER_HOURS=48
PM_HORIZON_DAYS=60
PM_HORIZON_DAYS_HOURLY=7

# ── Dashboard & papan monitor ──
PM_DASHBOARD_CACHE_SECONDS=300
PM_LIVE_UPCOMING_HOURS=48

# ── Notifikasi ──
PM_MAIL_NOTIFICATIONS=false              # true bila SMTP di bawah sudah diisi
MAIL_MAILER=smtp
MAIL_HOST=<smtp.inl.co.id>
MAIL_PORT=587
MAIL_USERNAME="<user smtp>"
MAIL_PASSWORD="<password smtp>"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=preventech@inl.co.id
MAIL_FROM_NAME="PrevenTech"
EXPO_ACCESS_TOKEN="<token Expo untuk push Android, boleh kosong>"
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Admin pertama ──
# NRK yang otomatis jadi admin saat login pertama lewat Portal (pisahkan koma); kosongkan setelah admin ada,
# atau pakai `php artisan pm:make-admin <NRK>` dari container pm-api.
PM_BOOTSTRAP_ADMIN_NRKS=
