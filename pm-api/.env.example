# ─── PrevenTech API (pm-api) — contoh .env untuk pengembangan lokal ───
# Salin ke .env lalu sesuaikan. Untuk server produksi pakai ../.env.prod.example (docker-compose).
# Nilai kosong = pakai default di config/*.php. Jangan commit file .env.

# ── Aplikasi ──
APP_NAME="PrevenTech"
APP_ENV=local
APP_KEY=                                   # php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# ── Log ──
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pm
DB_USERNAME=postgres
DB_PASSWORD=

# ── Cache, queue, berkas ──
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# Dev: sync. Produksi: database atau redis agar push/email tidak memblokir request (jalankan queue:work).
QUEUE_CONNECTION=sync

# ── Sesi web (Sanctum SPA cookie, pola sama dengan IDAS/Approver) ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=pm_app_session
SESSION_DOMAIN=                            # dev: kosong; produksi: domain pm-web (mis. pm.inl.co.id)
SESSION_SECURE_COOKIE=false                # true bila HTTPS
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000   # host:port pm-web yang boleh memakai cookie

# ── Redis (hanya bila CACHE/SESSION/QUEUE memakai redis) ──
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Portal INTES (docs/SSO.md) ──
# Portal produksi dipakai juga saat dev lokal (seperti Approver). PORTAL_INTERNAL_TOKEN = SSO_INTERNAL_TOKEN di .env Portal.
PORTAL_API_URL=https://portal.inl.co.id
PORTAL_WEB_URL=https://portal.inl.co.id
PORTAL_APP_ID=b7903129-b04e-4baa-938b-830dfe04e7a0   # UUID PrevenTech di tabel aplikasi Portal
PORTAL_INTERNAL_TOKEN=
PORTAL_HTTP_TIMEOUT=10
PORTAL_VERIFY_TLS=true

# ── Aturan PrevenTech ──
PM_WEB_URL=http://localhost:3000           # URL pm-web, dipakai di tautan notifikasi/email
PM_LEAD_GRADE_CODES=BOM,BOM-1,BOM-2,BOM-3  # grade Portal yang dianggap pimpinan (approve, delegasi, kelola PM)
PM_WORKING_DAYS=1,2,3,4,5                  # hari kerja (1 = Senin … 7 = Minggu)
PM_WO_AUTO_ACCEPT_DAYS=3                   # WO selesai dianggap diterima setelah n hari kerja
PM_APPROVAL_REMINDER_HOURS=24              # pengingat Form Request yang belum disetujui setelah n jam
PM_ATTACHMENT_DISK=local                   # disk Laravel untuk lampiran (storage/app/attachments)

# ── Nomor dokumen di PDF/cetakan (kop formulir) ──
PM_WO_DOC_NUMBER=FM-BOPS-10/05
PM_WO_DOC_EFFECTIVE_DATE=09-Sept-25
PM_WO_DOC_REVISION=01
PM_REQ_DOC_NUMBER=INLHO/BSIS-ITC/F-004
PM_REQ_DOC_EFFECTIVE_DATE=04-Mei-22
PM_REQ_DOC_REVISION=01
PM_REQ_DOC_VERSION_NOTE="versi dokumen : 1/Agustus 2019"

# ── Preventive Maintenance ──
PM_DUE_WINDOW_HOURS=48                     # tugas masuk JATUH TEMPO + pengingat PIC n jam sebelum jatuh tempo (48 = H-2)
PM_OVERDUE_REMINDER_HOURS=48               # pengingat ulang tugas terlambat tiap n jam
PM_HORIZON_DAYS=60                         # tugas digenerate sampai n hari ke depan
PM_HORIZON_DAYS_HOURLY=7                   # jadwal per jam: n hari ke depan

# ── Dashboard & papan monitor ──
PM_DASHBOARD_CACHE_SECONDS=300             # cache hasil dashboard (detik); 0 = tanpa cache
PM_LIVE_UPCOMING_HOURS=48                  # PM "mendekati jatuh tempo" di papan monitor (jam)

# ── Notifikasi ──
# In-app dan push Expo selalu aktif. Email opsional: PM_MAIL_NOTIFICATIONS=true + SMTP di bawah.
PM_MAIL_NOTIFICATIONS=false
MAIL_MAILER=log                            # produksi: smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=preventech@inl.co.id
MAIL_FROM_NAME="${APP_NAME}"
# Push Android (Expo). Token opsional untuk kuota lebih besar; URL default sudah benar.
EXPO_ACCESS_TOKEN=
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Admin pertama ──
# NRK yang otomatis mendapat role admin saat login pertama lewat Portal (pisahkan koma).
# Setelah admin ada, kosongkan lagi; kelola lewat menu Hak Akses atau `php artisan pm:make-admin <NRK>`.
PM_BOOTSTRAP_ADMIN_NRKS=
