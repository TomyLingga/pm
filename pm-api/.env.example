APP_NAME="PrevenTech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pm
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# Use `database` (or redis) in production so push/notification calls do not block requests.
QUEUE_CONNECTION=sync

# Web session (Sanctum SPA cookie, same pattern as IDAS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=pm_app_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Portal INTES (docs/SSO.md)
# Portal produksi dipakai juga saat dev lokal (seperti Approver). Token = SSO_INTERNAL_TOKEN di .env Portal.
PORTAL_API_URL=https://portal.inl.co.id
PORTAL_WEB_URL=https://portal.inl.co.id
PORTAL_APP_ID=b7903129-b04e-4baa-938b-830dfe04e7a0
PORTAL_INTERNAL_TOKEN=
PORTAL_HTTP_TIMEOUT=10
PORTAL_VERIFY_TLS=true

# PM-App rules
PM_WEB_URL=http://localhost:3000
PM_LEAD_GRADE_CODES=BOM,BOM-1,BOM-2,BOM-3
PM_WORKING_DAYS=1,2,3,4,5
PM_WO_AUTO_ACCEPT_DAYS=3
PM_ATTACHMENT_DISK=local

# Preventive Maintenance
# Tugas masuk JATUH_TEMPO + pengingat ke PIC sekian jam sebelum jatuh tempo (48 = H-2, 72 = H-3)
PM_DUE_WINDOW_HOURS=48
PM_OVERDUE_REMINDER_HOURS=48
PM_HORIZON_DAYS=60
PM_HORIZON_DAYS_HOURLY=7

# Dashboard: cache hasil (detik) dan jendela PM "mendekati jatuh tempo" di papan monitor (jam)
PM_DASHBOARD_CACHE_SECONDS=300
PM_LIVE_UPCOMING_HOURS=48

# Expo push (Android app)
EXPO_ACCESS_TOKEN=
